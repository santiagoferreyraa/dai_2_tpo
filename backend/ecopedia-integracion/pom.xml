<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.ecopedia</groupId>
        <artifactId>ecopedia-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>ecopedia-integracion</artifactId>
    <name>Ecopedia — Integración</name>
    <description>
        Componentes: ServicioDePagos (REST hacia la pasarela simulada),
        ServicioDeRedElectrica (SOAP hacia la distribuidora simulada).
        Concentra toda la salida hacia sistemas externos en un borde único.
    </description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
            Sin JPA todavía: este módulo no tiene tablas propias. Si ServicioDePagos termina
            guardando medios de pago, se agregan acá spring-boot-starter-data-jpa, Flyway y
            el datasource en application.yml, igual que en core y carga.

            Falta también spring-boot-starter-web-services (Spring-WS) para el cliente SOAP;
            se agrega cuando se genere el WSDL de la distribuidora. Ver ARQUITECTURA §3.1.
        -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
