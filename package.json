{
  "name": "ecopedia",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "mprocs",
    "dev:back": "node scripts/free-port.mjs 8081 && mvn -pl backend/ecopedia-core spring-boot:run -Dspring-boot.run.profiles=dev",
    "dev:pay": "node scripts/free-port.mjs 8083 && mvn -pl backend/ecopedia-integration spring-boot:run -Dspring-boot.run.profiles=dev",
    "dev:front": "node scripts/free-port.mjs 5173 && pnpm --dir frontend dev",
    "dev:plain": "concurrently --names back,pay,front --prefix-colors cyan,yellow,magenta --kill-others-on-fail \"pnpm dev:back\" \"pnpm dev:pay\" \"pnpm dev:front\"",
    "free-ports": "node scripts/free-port.mjs 8081 8083 5173",
    "build": "mvn -Pweb clean package",
    "start": "java -jar backend/ecopedia-core/target/ecopedia-core-0.1.0-SNAPSHOT.jar"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "mprocs": "^0.9.6"
  }
}
