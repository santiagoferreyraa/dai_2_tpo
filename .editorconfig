# Configuración de editor compartida. La entienden IntelliJ, VS Code y Eclipse sin plugins.
#
# Existe para que las cuatro máquinas produzcan bytes idénticos ante el mismo código.
# Es la primera línea de defensa; la segunda son Spotless (backend) y Prettier (frontend),
# que además corren en el build.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.java]
indent_size = 4
max_line_length = 120

[*.{ts,tsx,js,jsx,mjs,cjs}]
indent_size = 2
max_line_length = 100

[*.{json,yml,yaml}]
indent_size = 2

[*.xml]
indent_size = 4

# En Markdown dos espacios al final significan salto de línea: no los recortamos.
[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
